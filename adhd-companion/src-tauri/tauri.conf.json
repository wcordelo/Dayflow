{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Archived ADHD Companion Prototype",
  "version": "0.1.0",
  "identifier": "com.adhdcompanion.app",
  "build": {
    "beforeDevCommand": "bash scripts/deny-runtime.sh tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Archived ADHD Companion Prototype",
        "width": 980,
        "height": 720,
        "resizable": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": ["dmg", "app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {}
}
