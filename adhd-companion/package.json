{
  "name": "adhd-companion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Archived ADHD nudge companion prototype — migration reference only",
  "scripts": {
    "dev": "bash scripts/deny-runtime.sh dev",
    "build": "tsc && vite build",
    "preview": "bash scripts/deny-runtime.sh preview",
    "tauri": "bash scripts/deny-runtime.sh tauri",
    "test": "npm run test --prefix engine && cargo test --manifest-path src-tauri/Cargo.toml",
    "test:engine": "npm run test --prefix engine",
    "typecheck": "tsc --noEmit && npm run typecheck --prefix engine",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:e2e": "cargo test --manifest-path src-tauri/Cargo.toml --test e2e_pipeline -- --nocapture"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-notification": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
}
