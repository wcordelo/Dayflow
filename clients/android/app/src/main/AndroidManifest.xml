<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Dayflow is distributed to non-touch Chromebooks as well as phones;
         the Compose surface supports keyboard, mouse, resize, and multi-window
         input without making a touchscreen a Play-install requirement. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />

    <!-- Local Ollama/LM Studio development uses loopback HTTP only. The
         network security config keeps every other cleartext route disabled. -->
    <application
        android:allowBackup="false"
        android:label="Dayflow"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dayflow">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:resizeableActivity="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".capture.DayflowCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />
        <receiver
            android:name=".DayflowSyncWakeReceiver"
            android:exported="false" />
        <service
            android:name=".DayflowSyncWakeJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
