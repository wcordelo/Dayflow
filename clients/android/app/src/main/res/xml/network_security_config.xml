<?xml version="1.0" encoding="utf-8"?>
<!--
    Dayflow sync and provider traffic must use TLS. The only cleartext
    exception is an explicitly named loopback endpoint for a local model.
    Keep this list aligned with DayflowAIProviderStore's endpoint validator.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">ip6-localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">[::1]</domain>
    </domain-config>
</network-security-config>
